# ==============================================================================
# deplo.ai — Master Environment Configuration Template
# Copy this file to server/.env or root .env and fill in the values
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
# Optional comma-separated extra trusted browser origins for CORS/Socket.IO
# CORS_ORIGINS=http://localhost:3000

# PostgreSQL Database (Local or Cloud)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deplo_ai?schema=public"

# Authentication & Security
# REQUIRED in production (and must not use insecure defaults). Set strong random values.
JWT_SECRET="change-me-to-a-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="change-me-to-a-strong-random-key-32-bytes-min" # used for AES-256-GCM key derivation

# GitHub OAuth App Credentials
# Create at https://github.com/settings/developers
# Callback must match your GitHub OAuth App and frontend callback route.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5173/auth/callback"

# Cloud Providers API Keys (required for real deployments in normal mode)
# Render API: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=""

# Vercel API: https://vercel.com/account/tokens
VERCEL_API_KEY=""
VERCEL_TEAM_ID="" # Optional if using personal account

# Development-only explicit simulation (NEVER enable in production)
# When true (and NODE_ENV!=production), provider actions/health checks may be simulated
# and will be clearly labeled in logs/responses. Default is false.
ALLOW_SIMULATED_DEPLOYMENTS=false

